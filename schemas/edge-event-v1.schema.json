{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/edge-event-v1.schema.json",
  "title": "Edge Event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "target_ip": {
      "type": ["string", "null"],
      "format": "ip-address"
    },
    "target_port": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 65535
    },
    "error_code": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "timestamp",
    "service",
    "summary"
  ]
}