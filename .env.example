# Copy to .env and set the key: cp .env.example .env
# Docker Compose reads .env for the values below.

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

EDGE_LLAMA_MODEL=Qwen/Qwen2-1.5B-Instruct
EDGE_LLAMA_TIMEOUT=30

CLOUD_EMBEDDING_MODEL=BAAI/bge-m3
CLOUD_ANALYSIS_MODEL=Qwen/Qwen2.5-72B-Instruct
CLOUD_ANALYSIS_TIMEOUT=60
